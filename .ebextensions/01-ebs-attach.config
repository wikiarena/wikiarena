files:
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/01_attach_ebs_volume.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail
      exec > /var/log/ebs-attach-command.log 2>&1

      echo "=== EBS Volume Attachment Command Started at $(date) ==="

      EBS_VOLUME_ID=$(/opt/elasticbeanstalk/bin/get-config environment -k EBS_VOLUME_ID || true)
      AWS_REGION=$(/opt/elasticbeanstalk/bin/get-config environment -k AWS_REGION || true)
      if [ -z "${AWS_REGION:-}" ]; then
        AWS_REGION=$(curl -s http://169.254.169.254/latest/dynamic/instance-identity/document | awk -F '"' '/region/ {print $4}')
      fi

      if [ -z "${EBS_VOLUME_ID:-}" ]; then
        echo "ERROR: EBS_VOLUME_ID not set"
        exit 1
      fi

      INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
      echo "EBS Volume ID: $EBS_VOLUME_ID"
      echo "AWS Region: $AWS_REGION"
      echo "Instance ID: $INSTANCE_ID"

      CURRENT_ATTACHMENT=$(aws ec2 describe-volumes \
        --volume-ids "$EBS_VOLUME_ID" \
        --region "$AWS_REGION" \
        --query 'Volumes[0].Attachments[?InstanceId==`'"$INSTANCE_ID"'`].State' \
        --output text 2>/dev/null || echo "")

      if [ "$CURRENT_ATTACHMENT" = "attached" ]; then
        echo "EBS volume already attached to this instance"
        exit 0
      fi

      # If attached to a different instance, detach it first
      ATTACHED_INSTANCE=$(aws ec2 describe-volumes \
        --volume-ids "$EBS_VOLUME_ID" \
        --region "$AWS_REGION" \
        --query 'Volumes[0].Attachments[0].InstanceId' \
        --output text 2>/dev/null || echo "")

      if [ -n "$ATTACHED_INSTANCE" ] && [ "$ATTACHED_INSTANCE" != "None" ] && [ "$ATTACHED_INSTANCE" != "$INSTANCE_ID" ]; then
        echo "Volume currently attached to $ATTACHED_INSTANCE, detaching..."
        aws ec2 detach-volume --volume-id "$EBS_VOLUME_ID" --region "$AWS_REGION" || true
        echo "Waiting for volume to be available..."
        aws ec2 wait volume-available --volume-ids "$EBS_VOLUME_ID" --region "$AWS_REGION"
      fi

      echo "Waiting for EBS volume to be available..."
      for i in {1..30}; do
        VOLUME_STATE=$(aws ec2 describe-volumes \
          --volume-ids "$EBS_VOLUME_ID" \
          --region "$AWS_REGION" \
          --query 'Volumes[0].State' \
          --output text)
        if [ "$VOLUME_STATE" = "available" ]; then
          break
        fi
        echo "Volume state: $VOLUME_STATE, waiting..."
        sleep 10
      done

      echo "Attaching EBS volume $EBS_VOLUME_ID to instance $INSTANCE_ID..."
      aws ec2 attach-volume \
        --volume-id "$EBS_VOLUME_ID" \
        --instance-id "$INSTANCE_ID" \
        --device "/dev/sdf" \
        --region "$AWS_REGION"

      echo "Waiting for volume attachment..."
      for i in {1..30}; do
        ATTACHMENT_STATE=$(aws ec2 describe-volumes \
          --volume-ids "$EBS_VOLUME_ID" \
          --region "$AWS_REGION" \
          --query 'Volumes[0].Attachments[0].State' \
          --output text 2>/dev/null || echo "")
        if [ "$ATTACHMENT_STATE" = "attached" ]; then
          echo "EBS volume successfully attached"
          exit 0
        fi
        echo "Attachment state: $ATTACHMENT_STATE, waiting..."
        sleep 10
      done

      echo "ERROR: Volume attachment failed after waiting"
      exit 1

container_commands:
  01_run_attach_script:
    command: "/opt/elasticbeanstalk/hooks/appdeploy/pre/01_attach_ebs_volume.sh"